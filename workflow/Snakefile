import os

# Define a default before the envvars directive below: snakemake >= 9 raises a
# WorkflowError at startup if an envvars entry is not already set in the
# environment. Setting it here makes the workflow runnable out of the box.
os.environ.setdefault("HDF5_USE_FILE_LOCKING", "FALSE")

configfile: "config.yaml"

# Pass HDF5_USE_FILE_LOCKING through to jobs: cooler/h5py locks the same .mcool
# from multiple parallel jobs (qc plots, features) causing BlockingIOError.
envvars:
    "HDF5_USE_FILE_LOCKING"

SAMPLES = sorted(list(config["samples"].keys()))
OUTDIR = config.get("output", {}).get("dir", "results")

include: "rules/common.smk"
include: "rules/00_samples.smk"
include: "rules/01_qc_trim.smk"
include: "rules/02_align.smk"
include: "rules/03_pairs.smk"
include: "rules/04_matrix.smk"
include: "rules/05_qc_plots.smk"
include: "rules/06_features.smk"
include: "rules/07_differential_integrative.smk"

rule all:
    input:
        f"{OUTDIR}/metadata/sample_sheet.validated.tsv",
        expand(f"{OUTDIR}/qc/fastp/{{sample}}/fastp.html", sample=SAMPLES),
        expand(f"{OUTDIR}/pairs/filtered/{{sample}}.filtered.pairs.gz", sample=SAMPLES),
        expand(f"{OUTDIR}/pairs/filtered/{{sample}}.filtered.pairs.gz.px2", sample=SAMPLES),
        expand(f"{OUTDIR}/stats/pairtools/{{sample}}.filtered.stats.txt", sample=SAMPLES),
        expand(f"{OUTDIR}/matrices/{{sample}}.mcool", sample=SAMPLES),
        expand(f"{OUTDIR}/matrices/{{sample}}.hic", sample=SAMPLES) if EXPORT_HIC else [],
        expand(
            f"{OUTDIR}/features/{{sample}}/compartments_{{res}}bp.bedgraph",
            sample=SAMPLES,
            res=COMPARTMENT_RESOLUTIONS,
        ),
        expand(f"{OUTDIR}/features/{{sample}}/expected_cis_{FEATURE_RESOLUTION}bp.tsv", sample=SAMPLES),
        expand(f"{OUTDIR}/features/{{sample}}/insulation.tsv", sample=SAMPLES),
        expand(f"{OUTDIR}/features/{{sample}}/boundaries.bed", sample=SAMPLES),
        expand(f"{OUTDIR}/features/{{sample}}/loops.bedpe", sample=SAMPLES),
        expand(f"{OUTDIR}/features/{{sample}}/apa.png", sample=SAMPLES),
        expand(f"{OUTDIR}/features/{{sample}}/apa.tsv", sample=SAMPLES),
        expand(f"{OUTDIR}/qc/plots/{{sample}}/cis_trans.tsv", sample=SAMPLES),
        expand(f"{OUTDIR}/qc/plots/{{sample}}/distance_decay.png", sample=SAMPLES),
        expand(f"{OUTDIR}/qc/plots/{{sample}}/matrix_snapshot.png", sample=SAMPLES),
        f"{OUTDIR}/qc/plots/replicate_concordance.tsv",
        f"{OUTDIR}/qc/plots/boundary_overlap.tsv",
        f"{OUTDIR}/qc/plots/compartment_correlation.tsv",
        f"{OUTDIR}/integrative/differential_summary.tsv",
        f"{OUTDIR}/qc/multiqc/multiqc_report.html"
